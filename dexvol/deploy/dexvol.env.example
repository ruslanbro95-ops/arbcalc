# Copy to dexvol.env next to the binary and fill in.
#
# The service reads this file at startup so an unattended start needs no shell
# wrapper. A real environment variable always wins over a line here, so a
# one-off override on the command line still works.
#
# It holds your bot token: keep it out of git (it is gitignored) and readable
# only by you — `chmod 600 dexvol.env` on Linux and macOS.

# --- required ---

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Your numeric id, from @userinfobot. The bot answers this account and no
# other. Alerts land here too unless TELEGRAM_ALERT_CHAT_ID says otherwise.
# The service refuses to start without it.
TELEGRAM_OWNER_ID=

# Where alerts are posted. Leave it empty and they go to your own chat.
#
# Set it to a group or channel id to give a team the alerts: the bot only
# writes there, while every command still comes from TELEGRAM_OWNER_ID and
# nobody else. Group ids are negative, e.g. -1001234567890 — add the bot to
# the group and send /chatid there — the bot answers with the id to paste here.
#
# The one control open to everyone is the "Тихо 30 мин" button under an alert,
# which silences that single token for half an hour.
# TELEGRAM_ALERT_CHAT_ID=

# --- optional: everything below has a working default ---

# Target polling cadence. The spec asks for 10-15s.
# POLL_INTERVAL=12s

# How long after a minute ends before it is closed. This is the grace period
# for trades that arrive late; too short and real trades are dropped, too long
# and alerts lag.
#
# There is a floor: confirmations x block time + poll interval. A swap is
# invisible until two blocks are mined on top of it and then waits up to one
# poll, which on ethereum is 2 x 12s + 12s = 36s. The old 20s default sealed
# every minute before its last third could arrive, and ethereum measured $0.
# Lower this only if every chain you watch has fast blocks.
# SEAL_DELAY=45s

# Minimum volume, in USD, a minute must reach before its percentage counts.
#
# Changed from the bot with /minvolume, so this is only the starting value.
# It exists because a percentage against a tiny baseline is true and useless:
# a $222 minute against a $7 median reads +3272% and escalates, while the same
# token's 30m, 60m and 24h windows sit at -75%, -70% and -52%. Nothing rose.
# Set 0 to judge every minute however small.
# MIN_VOLUME_USD=1000

# How often the pool list is rebuilt. A token can list on a new DEX at any
# time, and a frozen pool list is the easiest way to lose coverage silently.
# POOL_REFRESH=5m

# How long raw trades are kept for debugging.
# RAW_TRADE_RETENTION=48h

# Where settings and data live.
# STATE_PATH=state.json
# DB_PATH=dexvol-data

# debug, info, warn, error
# LOG_LEVEL=info

# Your own RPC endpoints. The defaults are public and rate limited; on a busy
# watch list they will be the first thing to strain.
# RPC_ETHEREUM=
# RPC_BSC=
# RPC_BASE=
# RPC_SOLANA=
#
# getTransaction goes to a second endpoint, because no free Solana node does
# both: the one that answers every signature request refuses a batch holding
# more than one getTransaction, and the one that batches them rate limits
# signatures. Both are keyless.
# RPC_SOLANA_TX=https://api.mainnet-beta.solana.com
# RPC_ROBINHOOD=
# RPC_ARBITRUM=
# RPC_AVALANCHE=
# RPC_POLYGON=
# RPC_OPTIMISM=

# How many pool addresses may go into one eth_getLogs filter. The public
# defaults above answer -32602 "Request blocked" at ten or more, and they
# reject the whole request, so a token with ten pools would leave its chain
# with no data at all. Nine is measured, not guessed. Raise it once RPC_*
# points at your own node: fewer requests per poll.
# EVM_MAX_ADDRESSES_PER_CALL=9

# The OKX button's URL pattern, which could not be verified while this was
# built. Set it if the real page differs, or set it empty to drop the button.
# OKX_URL_TEMPLATE=https://web3.okx.com/token/{chain}/{address}
